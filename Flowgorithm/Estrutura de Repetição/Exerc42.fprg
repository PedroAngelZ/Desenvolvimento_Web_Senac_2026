    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="quad" type="Integer" array="False" size=""/>
            <assign variable="num" expression="15"/>
            <for variable="num" start="15" end="200" direction="inc" step="1">
                <assign variable="quad" expression="num * num"/>
                <output expression="num &amp; &quot;&#178; = &quot;&amp; quad" newline="True"/>
            </for>
        </body>
    </function>
