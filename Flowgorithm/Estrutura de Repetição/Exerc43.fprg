    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="mult" type="Integer" array="False" size=""/>
            <declare name="prod" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero:&quot;" newline="True"/>
            <input variable="num"/>
            <assign variable="mult" expression="1"/>
            <output expression="&quot;Tabuada do &quot; &amp; num" newline="True"/>
            <while expression="mult &lt;= 10">
                <assign variable="prod" expression="num * mult"/>
                <output expression="num &amp; &quot;x&quot; &amp; mult &amp; &quot;=&quot; &amp; prod" newline="True"/>
                <assign variable="mult" expression="mult + 1"/>
            </while>
        </body>
    </function>
</flowgorithm>
