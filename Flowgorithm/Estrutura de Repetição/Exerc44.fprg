<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc44"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-06 11:58:22 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNjsiMTE6NTI6MDAgIjsyNTQx"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNjsiMTE6NTg6MjIgIjsxOzI2NTk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="soma" type="Integer" array="False" size=""/>
            <declare name="contador" type="Integer" array="False" size=""/>
            <assign variable="soma" expression="0"/>
            <assign variable="contador" expression="1"/>
            <while expression="contador &lt;= 100">
                <assign variable="soma" expression="soma + contador"/>
                <assign variable="contador" expression="contador + 1"/>
            </while>
            <output expression="&quot;A soma dos 100 primeiros n&#250;meros naturais &#233;: &quot;&amp; soma" newline="True"/>
        </body>
    </function>
</flowgorithm>
