    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="somapares" type="Integer" array="False" size=""/>
            <assign variable="somapares" expression="0"/>
            <for variable="num" start="2" end="500" direction="inc" step="2">
                <assign variable="somapares" expression="somapares + num"/>
            </for>
            <output expression="somapares" newline="True"/>
        </body>
    </function>
</flowgorithm>
