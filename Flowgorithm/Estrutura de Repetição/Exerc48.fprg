<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc48"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-07 05:17:47 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6MTM6NDQgIjsyNTUw"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6MTc6NDcgIjsxOzI2NjU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="expoente" type="Integer" array="False" size=""/>
            <declare name="potencia" type="Integer" array="False" size=""/>
            <assign variable="expoente" expression="0"/>
            <while expression="expoente &lt;= 15">
                <assign variable="potencia" expression="3 ^ expoente"/>
                <output expression="&quot;3^&quot;&amp; expoente &amp; &quot; = &quot;&amp; potencia" newline="True"/>
                <assign variable="expoente" expression="expoente + 1"/>
            </while>
        </body>
    </function>
</flowgorithm>
