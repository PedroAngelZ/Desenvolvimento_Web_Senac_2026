<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc49"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-07 05:24:10 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6MTg6MzggIjsyNTU4"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6MjQ6MTAgIjsxOzI2NTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="base" type="Integer" array="False" size=""/>
            <declare name="expoente" type="Integer" array="False" size=""/>
            <declare name="potencia" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite a base:&quot;" newline="True"/>
            <input variable="base"/>
            <output expression="&quot;Digite o expoente:&quot;" newline="True"/>
            <input variable="expoente"/>
            <assign variable="potencia" expression="1"/>
            <for variable="i" start="1" end="expoente" direction="inc" step="1">
                <assign variable="potencia" expression="potencia * base"/>
            </for>
            <output expression="base &amp; &quot; elevado a &quot;&amp; expoente &amp; &quot; = &quot; &amp; potencia" newline="True"/>
        </body>
    </function>
</flowgorithm>
