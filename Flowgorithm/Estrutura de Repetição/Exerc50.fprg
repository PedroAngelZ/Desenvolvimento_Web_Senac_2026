<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc50"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-07 05:29:05 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6MjQ6NDYgIjsyNTU0"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6Mjk6MDUgIjsxOzI2NjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="termo1" type="Integer" array="False" size=""/>
            <declare name="termo2" type="Integer" array="False" size=""/>
            <declare name="proximo" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="termo1" expression="0"/>
            <assign variable="termo2" expression="1"/>
            <assign variable="i" expression="3"/>
            <while expression="i &lt;= 15">
                <assign variable="proximo" expression="termo1 + termo2"/>
                <output expression="proximo" newline="True"/>
                <assign variable="termo1" expression="termo2"/>
                <assign variable="termo2" expression="proximo"/>
                <assign variable="i" expression="i + 1"/>
            </while>
        </body>
    </function>
</flowgorithm>
