    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="gc" type="Integer" array="False" size=""/>
            <declare name="gf" type="Real" array="False" size=""/>
            <for variable="gc" start="10" end="100" direction="inc" step="10">
                <assign variable="gf" expression="(gc * 9 / 5) + 32"/>
                <output expression="gc &amp; &quot;&#176;C = &quot; &amp; gf &amp; &quot;&#176;F&quot;" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
