<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc52"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-07 05:44:04 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6MzQ6MjMgIjsyNTUw"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6NDQ6MDQgIjsxOzI2NTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="quadro" type="Integer" array="False" size=""/>
            <declare name="graosNoQuadro" type="Integer" array="False" size=""/>
            <declare name="totalGraos" type="Integer" array="False" size=""/>
            <assign variable="totalGraos" expression="0"/>
            <assign variable="quadro" expression="1"/>
            <while expression="quadro &lt;= 64">
                <assign variable="graosNoQuadro" expression="2 ^ (quadro - 1)"/>
                <assign variable="totalGraos" expression="totalGraos + graosNoQuadro"/>
                <assign variable="quadro" expression="quadro + 1"/>
            </while>
            <output expression="&quot;Total de gr&#227;os de trigo = &quot; &amp; totalGraos" newline="True"/>
        </body>
    </function>
</flowgorithm>
