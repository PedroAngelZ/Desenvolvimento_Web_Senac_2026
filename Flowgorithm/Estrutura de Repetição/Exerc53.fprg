<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc53"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-07 05:55:23 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6NDQ6MDYgIjsyNTUy"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNzsiMDU6NTU6MjMgIjsxOzI2NjE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="j" type="Integer" array="False" size=""/>
            <declare name="fatorial" type="Integer" array="False" size=""/>
            <declare name="somatorio" type="Integer" array="False" size=""/>
            <assign variable="somatorio" expression="0"/>
            <for variable="i" start="1" end="15" direction="inc" step="1">
                <output expression="&quot;Digite um valor:&quot;" newline="True"/>
                <input variable="valor"/>
                <assign variable="fatorial" expression="1"/>
                <for variable="j" start="1" end="valor" direction="inc" step="1">
                    <assign variable="fatorial" expression="fatorial * j"/>
                    <assign variable="somatorio" expression="somatorio + fatorial"/>
                </for>
            </for>
            <output expression="&quot;Somat&#243;rio das fatoriais = &quot; &amp; somatorio" newline="True"/>
        </body>
    </function>
</flowgorithm>
