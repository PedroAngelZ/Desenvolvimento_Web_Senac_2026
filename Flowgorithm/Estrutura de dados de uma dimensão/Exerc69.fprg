<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc69"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 09:31:50 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMDc6NDg6MTYgIjsyNTYy"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMDk6MzE6NTAgIjsxOzI2NjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vetor1" type="Integer" array="True" size="5"/>
            <declare name="vetor2" type="Integer" array="True" size="5"/>
            <declare name="vetor3" type="Integer" array="True" size="5"/>
            <declare name="vetorResultado" type="Integer" array="True" size="15"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="j" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Digite o elemento &quot;&amp; i &amp; &quot; do vetor 1:&quot;" newline="True"/>
                <input variable="vetor1[i]"/>
            </for>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Digite o elemento &quot;&amp; i &amp; &quot; do vetor 2:&quot;" newline="True"/>
                <input variable="vetor2[i]"/>
            </for>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Digite o elemento &quot;&amp; i &amp; &quot; do vetor 3:&quot;" newline="True"/>
                <input variable="vetor3[i]"/>
            </for>
            <assign variable="j" expression="0"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <assign variable="vetorResultado[j]" expression="vetor1[i]"/>
                <assign variable="j" expression="j + 1"/>
                <assign variable="vetorResultado[j]" expression="vetor2[i]"/>
                <assign variable="j" expression="j + 1"/>
                <assign variable="vetorResultado[j]" expression="vetor3[i]"/>
                <assign variable="j" expression="j + 1"/>
            </for>
            <output expression="&quot;Vetor 1:&quot;" newline="True"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="vetor1[i]" newline="True"/>
            </for>
            <output expression="&quot;Vetor 2:&quot;" newline="True"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="vetor2[i]" newline="True"/>
            </for>
            <output expression="&quot;Vetor 3:&quot;" newline="True"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="vetor3[i]" newline="True"/>
            </for>
            <output expression="&quot;Vetor Resultado:&quot;" newline="True"/>
            <for variable="i" start="0" end="14" direction="inc" step="1">
                <output expression="vetorResultado[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
