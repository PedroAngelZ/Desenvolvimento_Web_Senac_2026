<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc70"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 09:44:13 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMDk6MzE6NTQgIjsyNTU4"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMDk6NDQ6MTMgIjsxOzI2NjU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vetorOriginal" type="Integer" array="True" size="20"/>
            <declare name="vetorSomatorio" type="Integer" array="True" size="20"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="j" type="Integer" array="False" size=""/>
            <declare name="soma" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="19" direction="inc" step="1">
                <input variable="vetorOriginal[i]"/>
            </for>
            <for variable="i" start="0" end="19" direction="inc" step="1">
                <assign variable="soma" expression="0"/>
                <for variable="j" start="1" end="vetorOriginal[i]" direction="inc" step="1">
                    <assign variable="soma" expression="soma + j"/>
                </for>
                <assign variable="vetorSomatorio[i]" expression="soma"/>
            </for>
            <for variable="i" start="0" end="19" direction="inc" step="1">
                <output expression="vetorOriginal[i] &amp; &quot; -&gt; &quot; &amp; vetorSomatorio[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
