<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc71"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 09:56:07 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMDk6NDQ6MTggIjsyNTYy"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMDk6NTY6MDcgIjsxOzI2NzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vetorOriginal" type="Integer" array="True" size="10"/>
            <declare name="vetorNegativo" type="Integer" array="True" size="10"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <input variable="vetorOriginal[i]"/>
            </for>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <assign variable="vetorNegativo[i]" expression="-vetorOriginal[i]"/>
            </for>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <output expression="vetorOriginal[i]&amp; &quot; -&gt; &quot; &amp; vetorNegativo[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
