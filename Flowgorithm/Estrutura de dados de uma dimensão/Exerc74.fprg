<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc74"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 10:24:58 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTA6MTA6NTAgIjsyNTQz"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTA6MjQ6NTggIjsxOzI2NjQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="temperatura" type="Real" array="True" size="20"/>
            <declare name="menor" type="Real" array="False" size=""/>
            <declare name="maior" type="Real" array="False" size=""/>
            <declare name="soma" type="Real" array="False" size=""/>
            <declare name="media" type="Real" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="soma" expression="0"/>
            <for variable="i" start="0" end="19" direction="inc" step="1">
                <input variable="temperatura[i]"/>
                <if expression="i = 0">
                    <then>
                        <assign variable="menor" expression="temperatura[i]"/>
                        <assign variable="maior" expression="temperatura[i]"/>
                    </then>
                    <else/>
                </if>
                <if expression="temperatura[i] &lt; menor">
                    <then>
                        <assign variable="menor" expression="temperatura[i]"/>
                    </then>
                    <else/>
                </if>
                <if expression="temperatura[i] &gt; maior">
                    <then>
                        <assign variable="maior" expression="temperatura[i]"/>
                    </then>
                    <else/>
                </if>
                <assign variable="soma" expression="soma + temperatura[i]"/>
            </for>
            <assign variable="media" expression="soma / 20"/>
            <output expression="&quot;Menor temperatura: &quot;&amp; menor" newline="True"/>
            <output expression="&quot;Maior temperatura: &quot;&amp; maior" newline="True"/>
            <output expression="&quot;M&#233;dia: &quot;&amp; media" newline="True"/>
        </body>
    </function>
</flowgorithm>
