<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc76"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 10:40:24 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTA6MzI6MjIgIjsyNTQ2"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTA6NDA6MjQgIjsxOzI2NTU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vetorOriginal" type="Integer" array="True" size="12"/>
            <declare name="vetorResultante" type="Integer" array="True" size="12"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="11" direction="inc" step="1">
                <input variable="vetorOriginal[i]"/>
                <if expression="vetorOriginal[i] Mod 2 &lt;&gt; 0">
                    <then>
                        <assign variable="vetorResultante[i]" expression="vetorOriginal[i] * 2"/>
                    </then>
                    <else>
                        <assign variable="vetorResultante[i]" expression="vetorOriginal[i]"/>
                    </else>
                </if>
                <output expression="vetorOriginal[i]&amp; &quot; -&gt; &quot; &amp; vetorResultante[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
