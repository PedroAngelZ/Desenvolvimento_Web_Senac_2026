<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc79"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 11:26:44 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTE6MTE6MDcgIjsyNTQ3"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTE6MjY6NDQgIjsxOzI2NjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A" type="Integer" array="True" size="6"/>
            <declare name="B" type="Integer" array="True" size="6"/>
            <declare name="C" type="Integer" array="True" size="12"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="j" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="5" direction="inc" step="1">
                <input variable="A[i]"/>
                <while expression="A[i] Mod 2 &lt;&gt; 0">
                    <output expression="&quot;Digite um valor par:&quot;" newline="True"/>
                    <input variable="A[i]"/>
                </while>
            </for>
            <for variable="i" start="0" end="5" direction="inc" step="1">
                <input variable="B[i]"/>
                <while expression="B[i] Mod 2 = 0">
                    <output expression="&quot;Digite um valor &#237;mpar:&quot;" newline="True"/>
                    <input variable="B[i]"/>
                </while>
            </for>
            <assign variable="j" expression="0"/>
            <for variable="i" start="0" end="5" direction="inc" step="1">
                <assign variable="C[j]" expression="A[i]"/>
                <assign variable="j" expression="j + 1"/>
                <assign variable="C[j]" expression="B[i]"/>
                <assign variable="j" expression="j + 1"/>
            </for>
            <for variable="i" start="0" end="11" direction="inc" step="1">
                <output expression="C[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
