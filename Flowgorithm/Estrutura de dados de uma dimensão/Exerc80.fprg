<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc80"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 11:38:07 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTE6Mjc6NTEgIjsyNTUz"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0yODsiMTE6Mzg6MDcgIjsxOzI2NjQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vetor1" type="Integer" array="True" size="10"/>
            <declare name="vetor2" type="Integer" array="True" size="10"/>
            <declare name="vetor3" type="Integer" array="True" size="20"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="j" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <input variable="vetor1[i]"/>
                <while expression="vetor1[i] Mod 2 &lt;&gt; 0 Or vetor1[i] Mod 3 &lt;&gt; 0">
                    <output expression="&quot;Digite um valor divis&#237;vel por 2 e 3:&quot;" newline="True"/>
                    <input variable="vetor1[i]"/>
                </while>
            </for>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <input variable="vetor2[i]"/>
                <while expression="vetor2[i] Mod 5 &lt;&gt; 0">
                    <output expression="&quot;Digite um valor m&#250;ltiplo de 5:&quot;" newline="True"/>
                    <input variable="vetor2[i]"/>
                </while>
            </for>
            <assign variable="j" expression="0"/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <assign variable="vetor3[j]" expression="vetor1[i]"/>
                <assign variable="j" expression="j + 1"/>
                <assign variable="vetor3[j]" expression="vetor2[i]"/>
                <assign variable="j" expression="j + 1"/>
            </for>
            <for variable="i" start="0" end="19" direction="inc" step="1">
                <output expression="vetor3[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
