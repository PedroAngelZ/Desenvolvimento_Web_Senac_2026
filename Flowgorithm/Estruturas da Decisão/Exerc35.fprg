<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc35"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-06 10:55:00 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNjsiMTA6NDA6NDkgIjsyNTUw"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNjsiMTA6NTU6MDAgIjsxOzI2NTE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1" type="Integer" array="False" size=""/>
            <declare name="num2" type="Integer" array="False" size=""/>
            <declare name="num3" type="Integer" array="False" size=""/>
            <declare name="num4" type="Integer" array="False" size=""/>
            <declare name="num5" type="Integer" array="False" size=""/>
            <declare name="maior" type="Integer" array="False" size=""/>
            <declare name="menor" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o primeiro n&#250;mero:&quot;" newline="True"/>
            <input variable="num1"/>
            <output expression="&quot;Digite o segundo n&#250;mero:&quot;" newline="True"/>
            <input variable="num2"/>
            <output expression="&quot;Digite o terceiro n&#250;mero:&quot;" newline="True"/>
            <input variable="num3"/>
            <output expression="&quot;Digite o quarto n&#250;mero:&quot;" newline="True"/>
            <input variable="num4"/>
            <output expression="&quot;Digite o quinto n&#250;mero:&quot;" newline="True"/>
            <input variable="num5"/>
            <assign variable="maior" expression="num1"/>
            <assign variable="menor" expression="num1"/>
            <if expression="num2 &gt; maior">
                <then>
                    <assign variable="maior" expression="num2"/>
                </then>
                <else>
                    <if expression="num2 &lt; menor">
                        <then>
                            <assign variable="menor" expression="num2"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
            <if expression="num3 &gt; maior">
                <then>
                    <assign variable="maior" expression="num3"/>
                </then>
                <else>
                    <if expression="num3 &lt; menor">
                        <then>
                            <assign variable="menor" expression="num3"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
            <if expression="num4 &gt; maior">
                <then>
                    <assign variable="maior" expression="num4"/>
                </then>
                <else>
                    <if expression="num4 &lt; menor">
                        <then>
                            <assign variable="menor" expression="num4"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
            <if expression="num5 &gt; maior">
                <then>
                    <assign variable="maior" expression="num5"/>
                </then>
                <else>
                    <if expression="num5 &lt; menor">
                        <then>
                            <assign variable="menor" expression="num5"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
            <output expression="&quot;Maior valor: &quot;&amp; maior" newline="True"/>
            <output expression="&quot;Menor valor: &quot;&amp; menor" newline="True"/>
        </body>
    </function>
</flowgorithm>
