    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um valor inteiro:&quot;" newline="True"/>
            <input variable="valor"/>
            <if expression="valor &gt;= 1 And valor &lt;= 9">
                <then>
                    <output expression="&quot;Valor est&#225; na faixa permitida.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Valor n&#227;o est&#225; na faixa permitida.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
