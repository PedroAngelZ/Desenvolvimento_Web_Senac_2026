<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exerc40"/>
        <attribute name="authors" value="pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-06 11:23:06 "/>
        <attribute name="created" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNjsiMTE6MDk6NTYgIjsyNTU0"/>
        <attribute name="edited" value="cGVkcm87UEVEUk9BTkdFTE87MjAyNi0wNy0wNjsiMTE6MjM6MDYgIjsxOzI2NTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="val1" type="Integer" array="False" size=""/>
            <declare name="val2" type="Integer" array="False" size=""/>
            <declare name="val3" type="Integer" array="False" size=""/>
            <declare name="soma" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o primeiro valor:&quot;" newline="True"/>
            <input variable="val1"/>
            <output expression="&quot;Digite o segundo valor:&quot;" newline="True"/>
            <input variable="val2"/>
            <output expression="&quot;Digite o terceiro valor:&quot;" newline="True"/>
            <input variable="val3"/>
            <assign variable="soma" expression="val1 + val2 + val3"/>
            <if expression="soma &gt; 100">
                <then>
                    <output expression="soma" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
