    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="res" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero inteiro:&quot;" newline="True"/>
            <input variable="num"/>
            <assign variable="res" expression="num * 2"/>
            <if expression="res &gt; 30">
                <then>
                    <output expression="res" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
